# Server Environment
PORT=5000
NODE_ENV=development

# MySQL Database Connection (XAMPP default: root without password)
DATABASE_URL="mysql://root:@localhost:3306/njs_db"

# JWT Authentication
JWT_SECRET="njs_property_group_jwt_secret_key_2026_dev_secure"
JWT_EXPIRES_IN="7d"

# Client URLs allowed for CORS
CLIENT_URL="http://localhost:5175,http://localhost:5173"

# Third-Party API Keys (Placeholders)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
IDEAL_POSTCODES_API_KEY=""
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

